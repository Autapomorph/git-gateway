{
  "name": "tauri-proxy-updater",
  "version": "1.0.0",
  "description": "An auto-updater proxy server for Tauri applications, designed to work with a private repository.",
  "author": "Autapomorph",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "cross-env NODE_ENV=development tsup --watch --onSuccess \"node dist/server.js\"",
    "build:server": "cross-env NODE_ENV=production run-s typecheck && tsup",
    "lint": "run-s -c typecheck lint:js",
    "lint:js": "eslint",
    "lint:staged": "lint-staged --relative",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky || true"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "gray-matter": "^4.0.3",
    "mime-types": "^3.0.2",
    "semver": "^7.8.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/config-helpers": "^0.7.0",
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "@vercel/node": "^30.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-airbnb-extended": "^3.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.27.0": true,
    "unrs-resolver@1.12.2": true
  }
}
